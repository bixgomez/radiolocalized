<div class="song-teaser"
  data-nid="{{ node.id }}"
  data-start="{{ node.field_start_time.value }}"
  data-end="{{ node.field_end_time.value }}"
>
  <div class="mini-block">
    <div class="song-teaser__text">
      {{ label }}
      <span class="data--song-artist">{{ content.field_artist }}</span>
      <div class="song-teaser__coords hidden">
        {{ content.field_place }}
      </div>
      <span class="data--song-description hidden">{{ content.body[0]['#text']|default('') }}</span>
    </div>
    <div class="song-teaser__button">
      <button class="button--info" type="button" aria-expanded="false">
        <iconify-icon icon="material-symbols:play-arrow-rounded" width="24" height="24"></iconify-icon>
      </button>
    </div>
  </div>
</div>

<div class="song-info">
  <div class="mini-block">
    <div class="song-teaser__text">
      <div class="song-info__album">
        <b>Album:</b> <em>{{ content.field_album }}</em>
      </div>
      <div class="song-info__release">
        <b>Year:</b> {{ node.field_year_released.value }}
      </div>
      {% if node.field_place.0.entity %}
      <div class="song-info__place">
        <b>Place:</b> {{ node.field_place.0.entity.title.value }}
      </div>
      {% endif %}
    </div>
  </div>
</div>

{#
/**
 * @file
 * Theme override to display a region.
 *
 * Available variables:
 * - content: The content for this region, typically blocks.
 * - attributes: HTML attributes for the region <div>.
 * - region: The name of the region variable as defined in the theme's
 *   .info.yml file.
 *
 * @see template_preprocess_region()
 */
#}
{% if content %}
  {# Render content first to check if it's effectively empty #}
  {% set rendered_content %}{{ content }}{% endset %}
  {% set text_only = rendered_content|striptags|trim %}
  {%
    set classes = [
      'region',
      'region--' ~ region|clean_class,
      (text_only is empty and region != 'player') ? 'empty-region' : '',
    ]
  %}
  <div{{ attributes.addClass(classes) }}>
    <div class="region-inner">
      {{ rendered_content|raw }}
    </div>
  </div>
{% endif %}

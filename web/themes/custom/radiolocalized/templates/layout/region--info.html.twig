{% if content %}
  {# Render content first to check if it's effectively empty #}
  {% set rendered_content %}{{ content }}{% endset %}
  {% set text_only = rendered_content|striptags|trim %}
  {%
    set classes = [
      'region',
      'region--' ~ region|clean_class,
      text_only is empty ? 'empty-region' : '',
    ]
  %}
  <div{{ attributes.addClass(classes) }}>
    <div class="region-inner">
      {{ rendered_content|raw }}
    </div>
  </div>
{% endif %}

<div class="mixcloud-player-wrapper" data-episode-id="{{ episode_id }}">
  <iframe
    id="mixcloud-player"
    width="100%"
    height="120"
    src="https://www.mixcloud.com/widget/iframe/?feed={{ feed|url_encode }}&hide_cover=1&light=0"
    frameborder="0"
    allow="autoplay"
  ></iframe>
</div>

{#
/**
 * @file
 * Episode Audio Player template.
 *
 * Available variables:
 * - episode_title: The title of the episode
 * - episode_number: The episode number
 * - audio_url: URL to the audio file
 */
#}
<div class="episode-player" data-audio-url="{{ audio_url }}">
  <h3>{{ episode_title }}</h3>
  <div class="player-status">Episode {{ episode_number }}</div>
  
  <div class="waveform-container">
    <div id="waveform"></div>
  </div>
  
  <div class="player-controls">
    <button id="skip-back-30" type="button" class="btn btn-outline-secondary btn-sm" title="Skip back 30 seconds">
      ⏪ 30s
    </button>
    <button id="skip-back-15" type="button" class="btn btn-outline-secondary btn-sm" title="Skip back 15 seconds">
      ⏪ 15s
    </button>
    <button id="skip-back-5" type="button" class="btn btn-outline-secondary btn-sm" title="Skip back 5 seconds">
      ⏮ 5s
    </button>
    
    <button id="play-pause-btn" type="button" class="btn btn-primary btn-lg">
      <span class="play-icon">▶</span>
      <span class="pause-icon" style="display: none;">⏸</span>
    </button>
    
    <button id="skip-forward-5" type="button" class="btn btn-outline-secondary btn-sm" title="Skip forward 5 seconds">
      5s ⏭
    </button>
    <button id="skip-forward-15" type="button" class="btn btn-outline-secondary btn-sm" title="Skip forward 15 seconds">
      15s ⏩
    </button>
    <button id="skip-forward-30" type="button" class="btn btn-outline-secondary btn-sm" title="Skip forward 30 seconds">
      30s ⏩
    </button>
  </div>
  
  <div class="episode-controls">
    <strong>Current Time:</strong> 
    <span class="episode-timer">00:00</span>
  </div>
  
  <p class="episode-instructions">
    <small><strong>Instructions:</strong> Play the episode and use the "Set" buttons in the song table below to capture start and end times as you listen.</small>
  </p>
</div>
<?php

/**
 * @file
 * Contains song_sheets_import.module.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\views\ViewExecutable;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\node\NodeInterface;
use Drupal\views\Views;

/**
 * Implements hook_help().
 */
function song_sheets_import_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.song_sheets_import':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Imports song data from Google Sheets into Drupal song nodes.') . '</p>';
      return $output;

    default:
  }
}

/**
 * Helper function to load episode data by episode number.
 *
 * @param string $episode_number
 *   The episode number.
 *
 * @return array|null
 *   Array with episode data or NULL if not found.
 */
function song_sheets_import_load_episode_data($episode_number) {
  $episode_query = \Drupal::entityQuery('node')
    ->condition('type', 'episode')
    ->condition('field_episode_number', $episode_number)
    ->accessCheck(FALSE)
    ->range(0, 1);
  
  $episode_nids = $episode_query->execute();
  
  if (!empty($episode_nids)) {
    $episode_nid = reset($episode_nids);
    $episode = \Drupal::entityTypeManager()->getStorage('node')->load($episode_nid);
    
    if ($episode && $episode->hasField('field_audio_file') && !$episode->get('field_audio_file')->isEmpty()) {
      $audio_media = $episode->get('field_audio_file')->entity;
      
      if ($audio_media && $audio_media->hasField('field_media_audio_file') && !$audio_media->get('field_media_audio_file')->isEmpty()) {
        $audio_file = $audio_media->get('field_media_audio_file')->entity;
        
        if ($audio_file) {
          return [
            'episode' => $episode,
            'audio_url' => \Drupal::service('file_url_generator')->generateAbsoluteString($audio_file->getFileUri()),
            'episode_title' => $episode->getTitle(),
          ];
        }
      }
    }
  }
  
  return NULL;
}

/**
 * Helper to resolve an episode's audio URL from a node entity.
 *
 * @param \Drupal\node\NodeInterface $episode
 *   The episode node entity.
 *
 * @return string|null
 *   Absolute URL for the episode audio file or NULL if not available.
 */
function song_sheets_import_get_episode_audio_url(NodeInterface $episode) {
  if (!$episode->hasField('field_audio_file') || $episode->get('field_audio_file')->isEmpty()) {
    return NULL;
  }

  $audio_media = $episode->get('field_audio_file')->entity;
  if (!$audio_media || !$audio_media->hasField('field_media_audio_file') || $audio_media->get('field_media_audio_file')->isEmpty()) {
    return NULL;
  }

  $audio_file = $audio_media->get('field_media_audio_file')->entity;
  if (!$audio_file) {
    return NULL;
  }

  return \Drupal::service('file_url_generator')->generateAbsoluteString($audio_file->getFileUri());
}

/**
 * Implements hook_entity_extra_field_info().
 */
function song_sheets_import_entity_extra_field_info() {
  $extra = [];

  $extra['node']['episode']['form']['episode_audio_player'] = [
    'label' => t('Episode audio player'),
    'description' => t('WaveSurfer player for episode audio with time controls.'),
    'weight' => 5,
  ];

  $extra['node']['episode']['form']['episode_songs_view'] = [
    'label' => t('Episode songs table'),
    'description' => t('Songs table with Set/GoTo timestamp controls.'),
    'weight' => 6,
  ];

  return $extra;
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function song_sheets_import_form_node_episode_edit_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $form_object = $form_state->getFormObject();
  if (!$form_object || !method_exists($form_object, 'getEntity') || !method_exists($form_object, 'getFormDisplay')) {
    return;
  }

  $node = $form_object->getEntity();
  if (!$node instanceof NodeInterface || $node->bundle() !== 'episode') {
    return;
  }

  if (!$node->hasField('field_episode_number') || $node->get('field_episode_number')->isEmpty()) {
    return;
  }

  $episode_number = $node->get('field_episode_number')->value;
  if ($episode_number === NULL || $episode_number === '') {
    return;
  }

  $form_display = $form_object->getFormDisplay($form_state);

  if ($form_display->getComponent('episode_audio_player')) {
    $audio_url = song_sheets_import_get_episode_audio_url($node);
    if ($audio_url) {
      $form['episode_audio_player'] = [
        '#theme' => 'episode_audio_player',
        '#episode_title' => $node->getTitle(),
        '#episode_number' => $episode_number,
        '#audio_url' => $audio_url,
        '#attached' => [
          'library' => ['song_sheets_import/episode-player'],
        ],
        '#weight' => 5,
      ];
    }
  }

  if ($form_display->getComponent('episode_songs_view')) {
    $view = Views::getView('episodes');
    if ($view) {
      $view->setDisplay('page_episode_songs');
      // Pass episode nid as argument (view filters by field_episode entity reference).
      $view->setArguments([$node->id()]);
      $view->song_sheets_import_hide_player = TRUE;
      $view->song_sheets_import_hide_controls = TRUE;
      $render_array = $view->render();
      $render_array['#weight'] = 6;
      $form['episode_songs_view'] = $render_array;
    }
  }
}

/**
 * Implements hook_preprocess_views_view().
 */
function song_sheets_import_preprocess_views_view(&$variables) {
  $view = $variables['view'];

  // Add episode audio player data to episodes view
  if ($view->id() == 'episodes' && $view->current_display == 'page_episode_songs') {
    if (!empty($view->args)) {
      // Argument is now episode nid (not episode number).
      $episode_nid = $view->args[0];
      $episode = \Drupal::entityTypeManager()->getStorage('node')->load($episode_nid);

      $hide_player = !empty($view->song_sheets_import_hide_player);
      $variables['show_episode_audio_player'] = !$hide_player;
      $variables['show_episode_controls'] = empty($view->song_sheets_import_hide_controls);

      if ($episode && !$hide_player) {
        $audio_url = song_sheets_import_get_episode_audio_url($episode);
        $episode_number = $episode->hasField('field_episode_number') ? $episode->get('field_episode_number')->value : '';

        if ($audio_url) {
          // Add audio player variables to the template.
          $variables['episode_audio_player'] = [
            '#theme' => 'episode_audio_player',
            '#episode_title' => $episode->getTitle(),
            '#episode_number' => $episode_number,
            '#audio_url' => $audio_url,
            '#attached' => [
              'library' => ['song_sheets_import/episode-player'],
            ],
          ];
        }
      }

      if (empty($variables['episode_audio_player'])) {
        // Ensure episode player library is still attached for song controls.
        $variables['#attached']['library'][] = 'song_sheets_import/episode-player';
      }
    }
  }
}

/**
 * Implements hook_theme().
 */
function song_sheets_import_theme() {
  return [
    'episode_audio_player' => [
      'variables' => [
        'episode_title' => NULL,
        'episode_number' => NULL,
        'audio_url' => NULL,
      ],
      'template' => 'episode-audio-player',
    ],
  ];
}

/**
 * Implements hook_preprocess_views_view_table().
 */
function song_sheets_import_preprocess_views_view_table(&$variables) {
  $view = $variables['view'];
  
  // Add timestamp buttons to episode songs view
  if ($view->id() == 'episodes' && $view->current_display == 'page_episode_songs') {
    // Library is already attached in hook_preprocess_views_view()
    
    // Add timestamp buttons to each row
    foreach ($variables['rows'] as $row_index => &$row) {
      $song_id = $view->result[$row_index]->nid;
      
      // Get current timestamp values
      $song = \Drupal::entityTypeManager()->getStorage('node')->load($song_id);
      $start_time = $song ? $song->get('field_start_time')->value : '';
      $end_time = $song ? $song->get('field_end_time')->value : '';
      $duration = $song ? $song->get('field_duration')->value : '';
      
      // Add timestamp buttons to start time column
      if (isset($row['columns']['field_start_time']) && isset($row['columns']['field_end_time'])) {
        // Modify the start time cell to include current value, set button, and goto button
        $row['columns']['field_start_time']['content'][0]['field_output'] = [
          '#type' => 'container',
          '#attributes' => ['class' => ['timestamp-cell']],
          'timestamp' => [
            '#markup' => '<span class="timestamp-start">' . ($start_time ?: '--:--') . '</span> ',
          ],
          'set_button' => [
            '#type' => 'button',
            '#value' => 'Set',
            '#attributes' => [
              'class' => ['btn', 'btn-primary', 'btn-sm', 'song-timestamp-button'],
              'data-song-id' => $song_id,
              'data-field-type' => 'start',
              'type' => 'button',
            ],
          ],
          'goto_button' => [
            '#type' => 'button',
            '#value' => 'GoTo',
            '#attributes' => [
              'class' => ['btn', 'btn-secondary', 'btn-sm', 'song-goto-button'],
              'data-timestamp' => $start_time,
              'data-field-type' => 'start',
              'type' => 'button',
              'disabled' => empty($start_time),
            ],
          ],
        ];
        
        // Modify the end time cell to show only the current value (no buttons)
        $row['columns']['field_end_time']['content'][0]['field_output'] = [
          '#markup' => '<span class="timestamp-end">' . ($end_time ?: '--:--') . '</span>',
        ];

        // Ensure the duration cell has a predictable span for live updates.
        if (isset($row['columns']['field_duration'])) {
          $row['columns']['field_duration']['content'][0]['field_output'] = [
            '#markup' => '<span class="timestamp-duration">' . ($duration ?: '--:--') . '</span>',
          ];
        }
      }
    }
  }
}

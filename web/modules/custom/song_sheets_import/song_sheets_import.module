<?php

/**
 * @file
 * Contains song_sheets_import.module.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\views\ViewExecutable;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;

/**
 * Implements hook_help().
 */
function song_sheets_import_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.song_sheets_import':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Imports song data from Google Sheets into Drupal song nodes.') . '</p>';
      return $output;

    default:
  }
}

/**
 * Helper function to load episode data by episode number.
 *
 * @param string $episode_number
 *   The episode number.
 *
 * @return array|null
 *   Array with episode data or NULL if not found.
 */
function song_sheets_import_load_episode_data($episode_number) {
  $episode_query = \Drupal::entityQuery('node')
    ->condition('type', 'episode')
    ->condition('field_episode_number', $episode_number)
    ->accessCheck(FALSE)
    ->range(0, 1);
  
  $episode_nids = $episode_query->execute();
  
  if (!empty($episode_nids)) {
    $episode_nid = reset($episode_nids);
    $episode = \Drupal::entityTypeManager()->getStorage('node')->load($episode_nid);
    
    if ($episode && $episode->hasField('field_audio_file') && !$episode->get('field_audio_file')->isEmpty()) {
      $audio_media = $episode->get('field_audio_file')->entity;
      
      if ($audio_media && $audio_media->hasField('field_media_audio_file') && !$audio_media->get('field_media_audio_file')->isEmpty()) {
        $audio_file = $audio_media->get('field_media_audio_file')->entity;
        
        if ($audio_file) {
          return [
            'episode' => $episode,
            'audio_url' => \Drupal::service('file_url_generator')->generateAbsoluteString($audio_file->getFileUri()),
            'episode_title' => $episode->getTitle(),
          ];
        }
      }
    }
  }
  
  return NULL;
}

/**
 * Implements hook_preprocess_views_view().
 */
function song_sheets_import_preprocess_views_view(&$variables) {
  $view = $variables['view'];
  
  // Add episode audio player data to episodes view
  if ($view->id() == 'episodes' && $view->current_display == 'page_episode_songs') {
    if (!empty($view->args)) {
      $episode_number = $view->args[0];
      $episode_data = song_sheets_import_load_episode_data($episode_number);
      
      if ($episode_data) {
        // Add audio player variables to the template
        $variables['episode_audio_player'] = [
          '#theme' => 'episode_audio_player',
          '#episode_title' => $episode_data['episode_title'],
          '#episode_number' => $episode_number,
          '#audio_url' => $episode_data['audio_url'],
          '#attached' => [
            'library' => ['song_sheets_import/episode-player'],
          ],
        ];
      }
    }
  }
}

/**
 * Implements hook_theme().
 */
function song_sheets_import_theme() {
  return [
    'episode_audio_player' => [
      'variables' => [
        'episode_title' => NULL,
        'episode_number' => NULL,
        'audio_url' => NULL,
      ],
      'template' => 'episode-audio-player',
    ],
  ];
}

/**
 * Implements hook_preprocess_views_view_table().
 */
function song_sheets_import_preprocess_views_view_table(&$variables) {
  $view = $variables['view'];
  
  // Add timestamp buttons to episode songs view
  if ($view->id() == 'episodes' && $view->current_display == 'page_episode_songs') {
    // Library is already attached in hook_preprocess_views_view()
    
    // Add timestamp buttons to each row
    foreach ($variables['rows'] as $row_index => &$row) {
      $song_id = $view->result[$row_index]->nid;
      
      // Get current timestamp values
      $song = \Drupal::entityTypeManager()->getStorage('node')->load($song_id);
      $start_time = $song ? $song->get('field_start_time')->value : '';
      $end_time = $song ? $song->get('field_end_time')->value : '';
      
      // Add timestamp buttons to start time column
      if (isset($row['columns']['field_start_time']) && isset($row['columns']['field_end_time'])) {
        // Modify the start time cell to include current value and set button
        $row['columns']['field_start_time']['content'][0]['field_output'] = [
          '#type' => 'container',
          '#attributes' => ['class' => ['timestamp-cell']],
          'timestamp' => [
            '#markup' => '<span class="timestamp-start">' . ($start_time ?: '--:--') . '</span> ',
          ],
          'button' => [
            '#type' => 'button',
            '#value' => 'Set',
            '#attributes' => [
              'class' => ['btn', 'btn-primary', 'btn-sm', 'song-timestamp-button'],
              'data-song-id' => $song_id,
              'data-field-type' => 'start',
              'type' => 'button',
            ],
          ],
        ];
        
        // Modify the end time cell to show only the current value (no set button)
        $row['columns']['field_end_time']['content'][0]['field_output'] = [
          '#markup' => '<span class="timestamp-end">' . ($end_time ?: '--:--') . '</span>',
        ];
      }
    }
  }
}